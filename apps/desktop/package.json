{
  "name": "@salary-flow/desktop",
  "version": "0.4.0",
  "private": true,
  "description": "MoneyDance Windows app and local desktop companion",
  "author": "MoneyDance",
  "engines": { "node": ">=22.12.0" },
  "main": "src/main.cjs",
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.cjs",
    "start": "electron .",
    "build": "node scripts/prepare-assets.cjs --copy-web",
    "pack": "electron-builder --win --x64 --dir",
    "dist:win": "electron-builder --win nsis --x64",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "onnxruntime-node": "1.29.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.moneydance.desktop",
    "productName": "MoneyDance",
    "directories": { "output": "release" },
    "files": ["src/**", "web/**", "assets/**", "package.json", "!node_modules/onnxruntime-node/bin/napi-v6/{linux,darwin}/**", "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"],
    "asarUnpack": ["node_modules/onnxruntime-node/**", "node_modules/@img/**", "node_modules/sharp/**"],
    "win": { "target": ["nsis"], "icon": "assets/icon.png", "artifactName": "MoneyDance-${version}-windows-${arch}.${ext}" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "deleteAppDataOnUninstall": false }
  }
}
